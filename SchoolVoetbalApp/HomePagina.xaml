<Page
    x:Class="SchoolVoetbalApp.HomePagina"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SchoolVoetbalApp"
    xmlns:models="using:SchoolVoetbalApp.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" MaxWidth="700" HorizontalAlignment="Center">
        <Grid.Resources>
            <SolidColorBrush x:Key="AccentGreen" Color="#1B5E20" />
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="8" />
                <Setter Property="BorderBrush" Value="#ECECEC" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Width" Value="320" />
            </Style>
            <Style TargetType="TextBlock" x:Key="CardTitle">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AccentGreen}" />
            </Style>
        </Grid.Resources>

        <StackPanel Spacing="18" HorizontalAlignment="Center">
            <TextBlock x:Name="WelcomeText" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Grid.Column="0" Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="Huidig saldo" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="SaldoCard" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Grid.Column="1" Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="Totaal wedstrijden" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="MatchesCount" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Grid.Column="0" Grid.Row="1">
                    <StackPanel>
                        <TextBlock Text="Totaal gescoorde goals" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="TotalGoals" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Grid.Column="1" Grid.Row="1">
                    <StackPanel>
                        <TextBlock Text="Eerstvolgende wedstrijd" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="NextMatch" FontSize="16" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Grid.Column="0" Grid.Row="2">
                    <StackPanel>
                        <TextBlock Text="Laatste gespeelde wedstrijd" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="LastMatch" FontSize="16" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Grid.Column="1" Grid.Row="2">
                    <StackPanel>
                        <TextBlock Text="Top 3 scorende teams" Style="{StaticResource CardTitle}" />
                        <ItemsControl x:Name="TopTeamsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Team">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind Name}" Width="160" />
                                        <TextBlock Text="{x:Bind Goals}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>
        </StackPanel>
    </Grid>
</Page>
